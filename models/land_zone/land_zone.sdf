<?xml version="1.0"?>
<sdf version="1.9">
  <model name="land_zone">
    <static>true</static>

    <link name="link">

      <visual name="image_visual">
        <pose>0 0 0.05 0 0 0</pose>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.4 0.4</size>
          </plane>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>

          <pbr>
            <metal>
              <albedo_map>model://land_zone/materials/textures/landzone.jpg</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>